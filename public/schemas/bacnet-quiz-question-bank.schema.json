{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace-iot-solutions.github.io/bacnet-planning-studio/schemas/bacnet-quiz-question-bank.schema.json",
  "title": "BACnet Studio competency question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "questions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "difficulty", "prompt", "options", "correctIndex", "explanation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BAC-[0-9]{3,}$"
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "difficulty": {
            "enum": ["foundation", "intermediate", "advanced", "elite"]
          },
          "prompt": {
            "type": "string",
            "minLength": 12
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correctIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "explanation": {
            "type": "string",
            "minLength": 12
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
